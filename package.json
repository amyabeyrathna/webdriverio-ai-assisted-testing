{
  "name": "webdriverio-ai-assisted-testing",
  "version": "1.0.0",
  "private": true,
  "description": "WebdriverIO JavaScript automation framework with Allure reporting and AI-assisted testing",
  "type": "module",
  "scripts": {
    "test": "wdio run ./config/wdio.conf.js",
    "test:smoke": "wdio run ./wdio.conf.js --mochaOpts.grep @smoke",
    "test:regression": "wdio run ./wdio.conf.js --mochaOpts.grep @regression",
    "allure:generate": "allure generate ./reports/allure-results --clean -o ./reports/allure-report",
    "allure:open": "allure open ./reports/allure-report",
    "allure:serve": "allure serve ./reports/allure-results",
    "allure:clean": "rm -rf ./reports/allure-results ./reports/allure-report",
    "wdio": "wdio run ./wdio.conf.js"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^9.33.1",
    "@wdio/cli": "^9.33.1",
    "@wdio/globals": "^9.33.1",
    "@wdio/local-runner": "9.33.1",
    "@wdio/mocha-framework": "9.33.1",
    "@wdio/spec-reporter": "9.33.1",
    "@wdio/visual-service": "^9.3.0",
    "allure-commandline": "^2.46.1",
    "expect-webdriverio": "^5.6.2"
  }
}
