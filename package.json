{
  "name": "webdriverio-ai-assisted-testing",
  "version": "1.0.0",
  "private": true,
  "description": "WebdriverIO JavaScript automation framework with Allure reporting and an AI-assisted testing starter structure.",
  "type": "module",
  "scripts": {
    "test": "wdio run ./wdio.conf.js",
    "test:smoke": "wdio run ./wdio.conf.js --mochaOpts.grep @smoke",
    "test:regression": "wdio run ./wdio.conf.js --mochaOpts.grep @regression",
    "allure:generate": "allure generate ./reports/allure-results --clean -o ./reports/allure-report",
    "allure:open": "allure open ./reports/allure-report",
    "allure:serve": "allure serve ./reports/allure-results"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "@wdio/chromedriver-service": "^8.1.1",
    "allure-commandline": "^2.34.1"
  }
}
